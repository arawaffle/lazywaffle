{
  "name": "lazy-waffle",
  "productName": "LazyWaffle",
  "version": "1.2.0",
  "description": "바탕화면 대용 캘린더 · 체크리스트 · 메모 · 뽀모도로 · D-day · 용돈기입장",
  "author": "LazyWaffle",
  "license": "MIT",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node scripts/serve.js",
    "vendor": "node scripts/vendor.js",
    "holidays": "node scripts/make-holidays.js",
    "notices": "node scripts/make-notices.js",
    "build": "npm run notices && electron-builder --win dir --publish never",
    "build:portable": "npm run notices && electron-builder --win portable zip --publish never",
    "build:installer": "npm run notices && electron-builder --win nsis --publish never",
    "dist": "npm run notices && electron-builder --win nsis portable zip --publish never",
    "release": "npm run notices && electron-builder --win nsis portable zip --publish always",
    "taskbar-preview": "electron scripts/make-taskbar-preview.js"
  },
  "build": {
    "appId": "local.lazywaffle",
    "productName": "LazyWaffle",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arawaffle",
        "repo": "lazywaffle"
      }
    ],
    "files": [
      "electron/**",
      "renderer/**",
      "build/icon.png",
      "build/taskbar-preview*.png",
      "package.json",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**"
    ],
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "build/icon.png",
      "signExecutable": false,
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "portable": {
      "artifactName": "LazyWaffle-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "LazyWaffle-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LazyWaffle",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.4"
  },
  "devDependencies": {
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/playfair-display": "^5.3.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "fontkit": "^2.0.4",
    "fontverter": "^2.0.0",
    "htm": "^3.1.1",
    "korean-lunar-calendar": "^0.4.0",
    "preact": "^10.29.8",
    "subset-font": "^2.9.0"
  }
}
